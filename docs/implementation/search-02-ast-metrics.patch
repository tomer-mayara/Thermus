+package engine
+
+import (
+	"testing"
+
+	pb "github.com/ast-metrics/ast-metrics/pb"
+)
+
+func TestGetFunctionsInFile_AnonymousDeclarations(t *testing.T) {
+	for _, scenario := range []struct {
+		name   string
+		first  *pb.StmtLocationInFile
+		second *pb.StmtLocationInFile
+		want   int
+	}{
+		{"distinct spans", &pb.StmtLocationInFile{StartFilePos: 10, EndFilePos: 20}, &pb.StmtLocationInFile{StartFilePos: 30, EndFilePos: 40}, 2},
+		{"same span aliases", &pb.StmtLocationInFile{StartFilePos: 10, EndFilePos: 20}, &pb.StmtLocationInFile{StartFilePos: 10, EndFilePos: 20}, 1},
+		{"missing spans", nil, nil, 2},
+		{"empty spans", &pb.StmtLocationInFile{}, &pb.StmtLocationInFile{}, 2},
+	} {
+		t.Run(scenario.name, func(t *testing.T) {
+			firstPaths, secondPaths := int32(1), int32(3)
+			first := &pb.StmtFunction{
+				Name:     &pb.Name{Qualified: "Example."},
+				Location: scenario.first,
+				Stmts:    &pb.Stmts{Analyze: &pb.Analyze{Complexity: &pb.Complexity{Cyclomatic: &firstPaths}}},
+			}
+			second := &pb.StmtFunction{
+				Name:     &pb.Name{Qualified: "Example."},
+				Location: scenario.second,
+				Stmts:    &pb.Stmts{Analyze: &pb.Analyze{Complexity: &pb.Complexity{Cyclomatic: &secondPaths}}},
+			}
+			file := &pb.File{Stmts: &pb.Stmts{StmtNamespace: []*pb.StmtNamespace{{Stmts: &pb.Stmts{StmtFunction: []*pb.StmtFunction{first, second}}}}}}
+
+			functions := GetFunctionsInFile(file)
+
+			if len(functions) != scenario.want {
+				t.Fatalf("expected %d declarations, got %d", scenario.want, len(functions))
+			}
+			if functions[0] != first || functions[0].Stmts.Analyze.Complexity.GetCyclomatic() != firstPaths {
+				t.Fatal("the first declaration and its metrics must remain unchanged")
+			}
+			if scenario.want == 2 && (functions[1] != second || functions[1].Stmts.Analyze.Complexity.GetCyclomatic() != secondPaths) {
+				t.Fatal("the second declaration and its metrics must remain unchanged")
+			}
+		})
+	}
+}
+
+func TestGetFunctionsInFile_AnonymousAliases(t *testing.T) {
+	function := &pb.StmtFunction{Name: &pb.Name{Qualified: "Example."}}
+	class := &pb.StmtClass{Stmts: &pb.Stmts{StmtFunction: []*pb.StmtFunction{function}}}
+	file := &pb.File{Stmts: &pb.Stmts{
+		StmtNamespace: []*pb.StmtNamespace{{Stmts: &pb.Stmts{StmtFunction: []*pb.StmtFunction{function}}}},
+		StmtClass:     []*pb.StmtClass{class},
+		StmtFunction:  []*pb.StmtFunction{function},
+	}}
+
+	functions := GetFunctionsInFile(file)
+
+	if len(functions) != 1 || functions[0] != function {
+		t.Fatalf("expected one declaration across namespace, class, and file aliases, got %d", len(functions))
+	}
+}
+
+func TestGetFunctionsOutsideClassesInFile_DistinctAnonymousDeclarations(t *testing.T) {
+	method := &pb.StmtFunction{Name: &pb.Name{Qualified: "Example."}, Location: &pb.StmtLocationInFile{StartFilePos: 10, EndFilePos: 20}}
+	outside := &pb.StmtFunction{Name: &pb.Name{Qualified: "Example."}, Location: &pb.StmtLocationInFile{StartFilePos: 30, EndFilePos: 40}}
+	file := &pb.File{Stmts: &pb.Stmts{
+		StmtNamespace: []*pb.StmtNamespace{{Stmts: &pb.Stmts{StmtFunction: []*pb.StmtFunction{method, outside}}}},
+		StmtClass:     []*pb.StmtClass{{Stmts: &pb.Stmts{StmtFunction: []*pb.StmtFunction{method}}}},
+	}}
+
+	functions := GetFunctionsOutsideClassesInFile(file)
+
+	if len(functions) != 1 || functions[0] != outside {
+		t.Fatalf("expected the distinct outside declaration, got %d functions", len(functions))
+	}
+}
