+package typescript
+
+import (
+	"testing"
+
+	enginePkg "github.com/ast-metrics/ast-metrics/internal/engine"
+)
+
+func TestTypeScriptParser_PreservesAnonymousClassCallbacks(t *testing.T) {
+	const source = `class Example {
+    run(values: number[]) {
+        values.map(value => value + 1);
+        values.filter(value => value > 0 ? true : false);
+    }
+}`
+	file, err := enginePkg.CreateTestFileWithCode(&TypeScriptRunner{}, source)
+	if err != nil {
+		t.Fatalf("parse error: %v", err)
+	}
+	functions := enginePkg.GetFunctionsInFile(file)
+	if len(functions) != 3 {
+		t.Fatalf("expected the method and both anonymous callbacks, got %d functions", len(functions))
+	}
+	callbacks, ternaries := 0, 0
+	for _, function := range functions {
+		if function.Name.Short != "" {
+			continue
+		}
+		callbacks++
+		if function.Location == nil || function.Location.EndFilePos <= function.Location.StartFilePos {
+			t.Fatal("each callback must retain its concrete source span")
+		}
+		ternaries += len(function.Stmts.StmtDecisionTernary)
+	}
+	if callbacks != 2 || ternaries != 1 {
+		t.Fatalf("expected two distinct callbacks with one ternary between them, got %d callbacks and %d ternaries", callbacks, ternaries)
+	}
+}
