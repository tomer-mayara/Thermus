{
  "name": "magumagu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.10.1",
  "workspaces": [
    ".habit-hooks"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"dist/test/**/*.test.js\"",
    "test:unit": "tsc && node --test \"dist/test/unit/**/*.test.js\"",
    "test:interface": "tsc && node --test \"dist/test/interface/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "eslint": "10.10.0",
    "knip": "6.34.0",
    "ts-morph": "28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "ts-api-utils": {
      "typescript": "6.0.3"
    }
  },
  "dependencies": {
    "adblock-rs": "^0.13.3",
    "agent-input-sanitizer": "1.47.14",
    "css-select": "^7.0.0",
    "defuddle": "^0.19.4",
    "linkedom": "^0.18.13",
    "parse5": "8.0.1",
    "parse5-htmlparser2-tree-adapter": "8.0.1"
  }
}
