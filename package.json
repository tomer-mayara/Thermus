{
  "name": "thermus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.10.1",
  "workspaces": [
    ".habit-hooks"
  ],
  "imports": {
    "#auth-local-migrations/*": "./migrations/auth-local/*"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "test ! -L dist && { test ! -e dist || test -d dist; } && rm -rf dist && tsc --project tsconfig.build.json --outDir dist",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit && npm run typecheck:user-portal",
    "check": "npm run typecheck && npm run test:unit && npm run test:build && node --test \"test/acceptance/user-portal/**/*.test.ts\" && npm run build:user-portal",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\" && npm run test:user-portal",
    "test:unit": "npm run build && node --test \"dist/test/unit/**/*.test.js\" && node --test \"test/unit/user-portal/**/*.test.ts\"",
    "test:interface": "npm run build && node --test \"dist/test/interface/**/*.test.js\"",
    "test:interface:axiom": "npm run build && node --test dist/test/interface/logging/otel-logger-axiom.live.js",
    "test:integration": "npm run build && node --test \"dist/test/integration/**/*.test.js\"",
    "test:acceptance": "npm run build && node --test \"dist/test/acceptance/**/*.test.js\" && node --test \"test/acceptance/user-portal/**/*.test.ts\"",
    "test:container": "npm run build && THERMUS_CONTAINER_GATE=1 node --test dist/test/acceptance/auth/self-hosted-container.test.js",
    "test:hosted-live": "npm run build && node --test dist/test/acceptance/auth/hosted.live.js",
    "test:build": "node --test test/unit/build-output.test.ts",
    "dev:user-portal": "vite --config src/user-portal/vite.config.ts",
    "build:user-portal": "npm run typecheck:user-portal && vite build --config src/user-portal/vite.config.ts",
    "preview:user-portal": "vite preview --config src/user-portal/vite.config.ts",
    "typecheck:user-portal": "tsc --project tsconfig.user-portal.json",
    "test:user-portal": "node --test \"test/unit/user-portal/**/*.test.ts\" \"test/acceptance/user-portal/**/*.test.ts\""
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@types/css-tree": "3.2.0",
    "@types/node": "^24.19.1",
    "@workos-inc/authkit-js": "^0.12.0",
    "eslint": "10.10.0",
    "knip": "6.34.0",
    "playwright": "1.64.0",
    "ts-morph": "28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  },
  "overrides": {
    "ts-api-utils": {
      "typescript": "6.0.3"
    }
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.7",
    "@modelcontextprotocol/server": "2.3.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@workos-inc/node": "11.0.0",
    "adblock-rs": "^0.13.3",
    "agent-input-sanitizer": "1.47.14",
    "better-auth": "1.7.7",
    "css-select": "^7.0.0",
    "css-tree": "3.2.1",
    "defuddle": "^0.19.4",
    "htmlparser2": "^12.0.0",
    "jose": "6.2.12",
    "linkedom": "^0.18.13",
    "parse5": "8.0.1",
    "parse5-htmlparser2-tree-adapter": "8.0.1"
  }
}
