{
  "name": "magumagu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.10.1",
  "workspaces": [
    ".habit-hooks"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"dist/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "eslint": "10.10.0",
    "knip": "6.34.0",
    "ts-morph": "28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "ts-api-utils": {
      "typescript": "6.0.3"
    }
  }
}
