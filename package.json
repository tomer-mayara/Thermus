{
  "name": "thermus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.10.1",
  "workspaces": [
    ".habit-hooks"
  ],
  "imports": {
    "#auth-local-migrations/*": "./migrations/auth-local/*",
    "#hosted-portal/*": "./src/interfaces/user-portal/dist/*"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "test ! -L dist && { test ! -e dist || test -d dist; } && rm -rf dist && tsc --project tsconfig.build.json --outDir dist",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit && npm run typecheck:user-portal",
    "check": "npm run typecheck && npm run test:unit && node --test \"test/acceptance/user-portal/**/*.test.ts\" && npm run build:user-portal",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/test/**/!(hosted-image).test.js\" && npm run test:user-portal",
    "test:unit": "npm run build && node --test --test-concurrency=1 \"dist/test/unit/**/*.test.js\" && node --test \"test/unit/user-portal/**/*.test.ts\"",
    "test:interface": "npm run build && node --test \"dist/test/interface/**/*.test.js\"",
    "test:interface:axiom": "npm run build && node --test dist/test/interface/logging/system/otel-logger-axiom.live.js",
    "test:integration": "npm run build && node --test \"dist/test/integration/**/*.test.js\"",
    "test:acceptance": "npm run build && node --test --test-concurrency=1 \"dist/test/acceptance/**/!(hosted-image).test.js\" && node --test \"test/acceptance/user-portal/**/*.test.ts\"",
    "test:container": "npm run build && THERMUS_CONTAINER_GATE=1 node --test dist/test/acceptance/auth/self-hosted-container.test.js",
    "test:hosted-live": "npm run build && npm run build:user-portal && node --test --test-concurrency=1 dist/test/acceptance/auth/hosted.live.js dist/test/acceptance/auth/hosted-removal.live.js",
    "test:mcp:renderer": "npm run build && node --test dist/test/acceptance/mcp/get-url-as-markdown.runtime.js dist/test/acceptance/mcp/search-pipeline.runtime.js",
    "test:mcp:search:live": "npm run build && node --test dist/test/acceptance/mcp/search-pipeline.live.js",
    "test:logging:postgres": "npm run build && node --test --test-concurrency=1 dist/test/acceptance/logging/audit/destination-settings.runtime.js dist/test/acceptance/logging/audit/hosted-storage-failure.runtime.js dist/test/integration/logging/audit/destination-settings.runtime.js dist/test/integration/logging/audit/removal-operations.runtime.js dist/test/acceptance/auth/membership-removal.runtime.js dist/test/acceptance/auth/membership-removal-restart.runtime.js dist/test/acceptance/auth/hosted-member-removal-integrated.runtime.js dist/test/integration/tenants/tenant-registry-store.runtime.js dist/test/acceptance/tenants/tenant-registry.runtime.js",
    "test:logging:collector": "npm run build && node --test --test-concurrency=1 dist/test/integration/logging/audit/audit-sender.runtime.js dist/test/acceptance/logging/audit/hosted-audit-journey.runtime.js",
    "work-slice:basic-mcp-url-fetch": "tsx test/acceptance/work-slice/basic-mcp-url-fetch/basic-mcp-url-fetch.ts",
    "work-slice:auth-workos-mcp-url-fetch": "tsx test/acceptance/work-slice/auth-workos-mcp-url-fetch/auth-workos-mcp-url-fetch.ts",
    "dev:user-portal": "vite --config src/interfaces/user-portal/vite.config.ts",
    "build:user-portal": "npm run typecheck:user-portal && vite build --config src/interfaces/user-portal/vite.config.ts",
    "preview:user-portal": "vite preview --config src/interfaces/user-portal/vite.config.ts",
    "typecheck:user-portal": "tsc --project tsconfig.user-portal.json",
    "test:user-portal": "node --test \"test/unit/user-portal/**/*.test.ts\" \"test/acceptance/user-portal/**/*.test.ts\"",
    "build:hosted": "npm run check && node --test \"dist/test/integration/**/*.test.js\" && node --test dist/test/acceptance/hosted-ad-policy.test.js dist/test/acceptance/auth/hosted-startup.test.js dist/test/acceptance/auth/hosted-portal.test.js dist/test/acceptance/auth/hosted-mcp-origin.test.js dist/test/acceptance/auth/hosted-workos-signup.test.js dist/test/acceptance/auth/hosted-signup-restart.test.js dist/test/acceptance/auth/hosted-signup-guidance.test.js dist/test/acceptance/auth/hosted-mcp-signup-guidance.test.js dist/test/acceptance/mcp/hosted-fetch-tool.test.js dist/test/acceptance/mcp/search-pipeline.test.js dist/test/acceptance/mcp/hosted-search-capacity.test.js dist/test/acceptance/mcp/hosted-capacity-setting.test.js dist/test/acceptance/mcp/hosted-tenant-role.test.js dist/test/acceptance/mcp/hosted-tenant-capacity.test.js dist/test/acceptance/mcp/search-lifecycle.test.js dist/test/acceptance/mcp/hosted-process-shutdown.test.js dist/test/acceptance/mcp/server-only-modules.test.js dist/test/interface/hosted-renderer-startup.test.js && node --test dist/test/acceptance/mcp/get-url-as-markdown.runtime.js dist/test/acceptance/mcp/search-pipeline.runtime.js",
    "test:container:hosted": "npm run build && node --test dist/test/acceptance/auth/hosted-image.test.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@types/css-tree": "3.2.0",
    "@types/node": "^24.19.1",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "knip": "6.34.0",
    "playwright": "1.64.0",
    "stripe": "23.0.1",
    "ts-morph": "28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.0.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "ts-api-utils": {
      "typescript": "6.0.3"
    }
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.7",
    "@modelcontextprotocol/server": "2.3.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@workos-inc/node": "11.0.0",
    "adblock-rs": "^0.13.3",
    "agent-input-sanitizer": "1.47.14",
    "better-auth": "1.7.7",
    "css-select": "^7.0.0",
    "css-tree": "3.2.1",
    "defuddle": "^0.19.4",
    "htmlparser2": "^12.0.0",
    "jose": "6.2.12",
    "linkedom": "^0.18.13",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "parse5": "8.0.1",
    "parse5-htmlparser2-tree-adapter": "8.0.1",
    "pg": "8.23.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  }
}
