+
+for (const captured of [
+  event,
+  { ...event, tool: 'getURLAsMarkdown', input: { url: 'https://example.com', reason: 'public reason' } },
+  { ...event, eventName: 'audit.destination.test', destinationRevision: 'saved-r1' },
