ont-size:40px}}\n@media(max-width:480px){.header-content,.members-layout,.site-footer{width:calc(100% - 32px)}.brand img{width:120px}nav{gap:12px}nav a{font-size:13px}.invite-card,.members-card{padding:20px}h1{font-size:36px}h2{font-size:24px}.member-row{gap:8px}.invitation-actions{display:grid;grid-template-columns:minmax(0,1fr)}}\n</style></head>\n<body><a class="skip-link" href="#main-content">Skip to content</a>\n<header class="site-header"><div class="header-content"><a class="brand" href="/" aria-label="Thermus home"><img src="/assets/thermus-logo.svg" alt="thermus" width="166" height="40"></a>\n<nav aria-label="Workspace"><a href="/">Product / Connect</a><a href="/members" >Members</a><a href="/logging" aria-current="page">Audit logs</a><a href="/organizations">Switch workspace</a></nav></div></header>\n<main id="main-content" class="members-layout logging-layout"><div class="introduction"><p class="eyebrow">Workspace administration</p><h1>Audit logs</h1></div>\n<section class="invite-card" aria-labelledby="destination-heading"><h2 id="destination-heading">Audit log destination</h2>\n<section class="logging-result" role="alert" aria-labelledby="logging-result-title"><h3 id="logging-result-title">Audit logs unavailable</h3><p>Audit logs settings are unavailable. Read saved settings before making another change.</p></section>\n<p>Save one destination for your organization's audit logs. Thermus system logs are internal.</p>\n<aside class="destination-notice" role="note" aria-label="Organization data"><p>Send organization data only if you have authority to do so. Check destination access and retention. Read our <a href="https://thermus.ai/privacy/">Privacy Policy</a>.</p></aside>\n<p><a href="/logging">Read saved settings</a></p><details class="administration-help" data-help="audit" data-document-version="hosted-audit-help-organization-removal-proposal-2026-10-26-v1" data-document-sha256="91c500488861110b50b01aea8cda7ba60cf5a7990e5a398a9124742b77588391">\n<summar