habit-sensors: sensor 'eslint' failed: files=$(printf '%s\n' ${files} | grep -E '\.(tsx?|jsx?|[cm]js)$' || true)
if [ -z "$files" ]; then echo '[]'; exit 0; fi
set -o pipefail
complaint=$(mktemp)
trap 'rm -f "$complaint"' EXIT
report=$(eslint -f json --no-warn-ignored ${args} $files 2>"$complaint")
status=$?
if [ "$status" -gt 1 ] && grep -qF "couldn't find an eslint.config" "$complaint"; then
  report=$(eslint -f json --no-warn-ignored --config ${dir}/../eslint.config.mjs ${args} $files 2>"$complaint")
  status=$?
fi
if [ "$status" -gt 1 ] || [ -z "$report" ]; then cat "$complaint" >&2; exit 2; fi
printf '%s' "$report" | jq '[.[] | .filePath as $file | .messages[]
| select(.ruleId != null or .fatal) | {
  smell: (if .fatal then "parse-error" else ({
    "max-lines-per-function": "oversized-function",
    "max-params": "too-many-parameters",
    "@typescript-eslint/max-params": "too-many-parameters",
    "complexity": "high-complexity",
    "max-depth": "deep-nesting",
    "max-lines": "oversized-file",
    "no-unused-vars": "unused-variable",
    "@typescript-eslint/no-unused-vars": "unused-variable",
    "eqeqeq": "loose-equality",
    "no-var": "var-declaration",
    "prefer-const": "non-const-binding",
    "no-duplicate-imports": "duplicate-import",
    "no-warning-comments": "warning-comment",
    "@typescript-eslint/no-explicit-any": "explicit-any",
    "@typescript-eslint/no-non-null-assertion": "non-null-assertion",
    "@typescript-eslint/no-inferrable-types": "redundant-type-annotation"
  }[.ruleId] // .ruleId) end),
  file: $file, line: .line, column: .column, message: .message,
  source: ("eslint:" + (.ruleId // "fatal"))
}]
| group_by(.smell)
| map({
    smell: .[0].smell,
    details: {},
    issues: map({
      key: .file,
      details: {file: .file, line: .line, column: .column, message: .message, source: .source}
    })
  })'

